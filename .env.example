# Tectranz LMS Environment Configuration Template

# Server Port & URL
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (Defaults to embedded SQLite with WAL mode)
DATABASE_PATH="./data/tectranz_lms.db"

# Authentication Secrets (Generate 32+ character high-entropy key in production)
JWT_SECRET="tectranz-lms-production-secure-secret-key-32chars!!"

# Payment Gateway Integration (Razorpay / Provider Adapter)
PAYMENT_WEBHOOK_SECRET="whsec_tectranz_razorpay_secret_key_prod_test"
RAZORPAY_KEY_ID="rzp_test_replace_with_live"
RAZORPAY_KEY_SECRET="rzp_secret_replace_with_live"

# Storage Configuration (Private object store adapter)
STORAGE_DRIVER="local" # 'local' | 's3' | 'r2'
STORAGE_LOCAL_ROOT="./data/storage"

# Email Delivery (Background queue sandbox by default)
EMAIL_PROVIDER="sandbox" # 'sandbox' | 'resend' | 'ses'
RESEND_API_KEY=""
